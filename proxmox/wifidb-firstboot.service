[Unit]
Description=Set up this WiFiDB container (first boot)
After=network-online.target systemd-resolved.service
Wants=network-online.target
Before=apache2.service cron.service wifidb-monitord.service wifidb-websocketd.service
ConditionPathExists=/etc/wifidb/firstboot-pending

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/wifidb-firstboot
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
