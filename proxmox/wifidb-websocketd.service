[Unit]
Description=WiFiDB websocket daemon (live APs and the scheduling page)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/wifidb/tools/daemon.config.inc.php

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/wifidb/tools/daemon
ExecStart=/usr/bin/php /opt/wifidb/tools/daemon/websocketd.php
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
