[Unit]
Description=WiFiDB monitor daemon (watches the other daemons' PID files and records their status)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/wifidb/tools/daemon.config.inc.php

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/wifidb/tools/daemon
ExecStart=/usr/bin/php /opt/wifidb/tools/daemon/monitord.php
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
