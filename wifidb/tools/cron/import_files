#!/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/unison

cd ${0%/*}
mkdir -p ../log/import

# How many import runs are due on this node (0 when the node's daemons are switched off).
# schedulecheck.php connects to the database the same way the daemons do, so no credentials are needed here.
runcount=$(php ../daemon/schedulecheck.php Import)
DATE_WITH_TIME=`date -u "+%Y-%m-%d %H:%M:%S"`

echo "[$DATE_WITH_TIME] ${runcount:-0} processes needed."
if [ "${runcount:-0}" -ge 1 ]; then
	for (( c=1; c<=$runcount; c++ ))
	do
		echo "executing processes $c"
		timestamp=$(date +%s)
		logfile=importd_${timestamp}_${c}.log
		php ../daemon/importd.php -o -v --logfile="${logfile}" > ../log/import/${logfile} &
		sleep 1s
	done
fi
echo "Cleaning up old logs..."
find ../log/import/ -mtime +1 -type f -delete

echo "Done. Exiting."
exit 0
