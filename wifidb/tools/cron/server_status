#!/bin/bash
# This node's report for admin/servers.php (version, load, memory, disks, services), each minute.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

cd ${0%/*}
mkdir -p ../log
LOGFILE="../log/server_status.log"
php ../daemon/server_status.php >> "$LOGFILE" 2>&1

# Only failures are written; keep the log from growing without bound
if [ -f "$LOGFILE" ] && [ "$(wc -c < "$LOGFILE")" -gt 1048576 ]; then
    tail -c 262144 "$LOGFILE" > "$LOGFILE.trimmed" && mv "$LOGFILE.trimmed" "$LOGFILE"
fi
exit 0
