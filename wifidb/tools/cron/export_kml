#!/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/unison

cd ${0%/*}
mkdir -p ../log/export

# How many export runs are enabled on this node (0 when the node's daemons are switched off).
# exportd.php decides for itself when its schedule row is due, so the next run time is not checked here.
runcount=$(php ../daemon/schedulecheck.php Export --ignore-nextrun)
DATE_WITH_TIME=`date -u "+%Y-%m-%d %H:%M:%S"`

echo "[$DATE_WITH_TIME] ${runcount:-0} processes needed."
if [ "${runcount:-0}" -ge 1 ]; then
	for (( c=1; c<=$runcount; c++ ))
	do
		echo "executing processes $c"
		timestamp=$(date +%s)
		logfile=exportd_${timestamp}_${c}.log
		php ../daemon/exportd.php -o -v --logfile="${logfile}" > ../log/export/${logfile} &
		sleep 1s
	done
fi
echo "Cleaning up old logs..."
find ../log/export/ -mtime +1 -type f -delete

echo "Done. Exiting."
exit 0
