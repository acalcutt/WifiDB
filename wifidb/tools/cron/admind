#!/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/unison

cd ${0%/*}
mkdir -p ../log/admind

# How many admin runs are due on this node (0 when the node's daemons are switched off).
runcount=$(php ../daemon/schedulecheck.php Admin)
DATE_WITH_TIME=`date -u "+%Y-%m-%d %H:%M:%S"`

echo "[$DATE_WITH_TIME] ${runcount:-0} processes needed."
if [ "${runcount:-0}" -ge 1 ]; then
	for (( c=1; c<=$runcount; c++ ))
	do
		echo "executing scheduled admind process $c"
		timestamp=$(date +%s)
		logfile=admind_${timestamp}_${c}.log
		php ../daemon/admind.php -o -v --logfile="${logfile}" > ../log/admind/${logfile} &
		sleep 1s
	done
else
	echo "No scheduled runs. Not starting admind."
fi

echo "Cleaning up old logs..."
find ../log/admind/ -mtime +1 -type f -delete

echo "Done. Exiting."
exit 0
