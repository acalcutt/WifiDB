--
-- WifiDB blank database -- PostgreSQL
--
-- Generated from blank_db.sqlsrv (the MSSQL schema is the source of truth).
--
-- All identifiers are double-quoted so they keep the exact case used by the
-- MySQL/MSSQL schemas. The PHP layer reads result rows by those names
-- ($row['GPS_ID'], $row['Country'], ...), and unquoted identifiers would be
-- folded to lower case by Postgres and break every one of those lookups.
-- Queries in the pgsql branches must quote identifiers the same way.
--
-- Usage:  createdb wifi && psql -d wifi -f blank_db.pgsql
--

BEGIN;

SET client_encoding = 'UTF8';
SET standard_conforming_strings = on;

CREATE TABLE "admin_jobs" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "job_type" varchar(50) NOT NULL,
    "target_id" integer NOT NULL,
    "target_table" varchar(100) NOT NULL,
    "requested_by" varchar(100) NOT NULL,
    "status" varchar(20) DEFAULT 'pending' NOT NULL,
    "created_at" timestamp DEFAULT CURRENT_TIMESTAMP NOT NULL,
    "started_at" timestamp,
    "completed_at" timestamp,
    "error_message" text,
    "nodename" varchar(255),
    "pid" integer,
    "message" text,
    CONSTRAINT "PK_admin_jobs" PRIMARY KEY ("id")
);

CREATE TABLE "annunc" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "enabled" smallint DEFAULT 0 NOT NULL,
    "auth" varchar(32) DEFAULT 'Annon Coward' NOT NULL,
    "title" varchar(120) DEFAULT 'Blank' NOT NULL,
    "date" timestamp DEFAULT CURRENT_TIMESTAMP NOT NULL,
    "body" text NOT NULL,
    "comments" text NOT NULL,
    CONSTRAINT "PK_annunc_id" PRIMARY KEY ("id"),
    CONSTRAINT "annunc$title" UNIQUE ("title")
);

CREATE TABLE "boundaries" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "name" varchar(255) NOT NULL,
    "polygon" text NOT NULL,
    CONSTRAINT "PK_boundaries_id" PRIMARY KEY ("id")
);

CREATE TABLE "cell_carriers" (
    "carrier_id" bigint GENERATED BY DEFAULT AS IDENTITY (START WITH 1691) NOT NULL,
    "mcc" integer,
    "mcc_int" integer,
    "mnc" varchar(8),
    "mnc_int" integer,
    "iso" varchar(16),
    "country" varchar(128),
    "country_code" varchar(16),
    "network" varchar(255),
    CONSTRAINT "PK_cell_carriers_carrier_id" PRIMARY KEY ("carrier_id")
);

CREATE TABLE "cell_hist" (
    "cell_hist_id" bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "cell_id" bigint NOT NULL,
    "file_id" bigint,
    "gps_id" bigint,
    "rssi" integer,
    "hist_date" timestamp(3),
    "new" smallint DEFAULT 0,
    CONSTRAINT "PK_cell_hist_cell_hist_id" PRIMARY KEY ("cell_hist_id")
);

CREATE TABLE "cell_id" (
    "cell_id" bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "file_id" bigint,
    "mac" varchar(255) NOT NULL,
    "ssid" varchar(255) NOT NULL,
    "authmode" varchar(255) NOT NULL,
    "chan" integer NOT NULL,
    "type" varchar(255) NOT NULL,
    "highgps_id" bigint,
    "high_rssi" integer,
    "high_gps_rssi" integer,
    "fa" timestamp(3),
    "la" timestamp(3),
    "points" bigint,
    "cell_hash" varchar(255) NOT NULL,
    "ModDate" timestamp(3) DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT "PK_cell_id_cell_id" PRIMARY KEY ("cell_id")
);

CREATE TABLE "daemon_pid_stats" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "nodename" varchar(255) NOT NULL,
    "pidfile" varchar(255) NOT NULL,
    "pid" varchar(255) NOT NULL,
    "pidtime" varchar(255) NOT NULL,
    "pidcpu" varchar(255),
    "pidmem" varchar(255) NOT NULL,
    "pidcmd" varchar(255) NOT NULL,
    "date" timestamp DEFAULT CURRENT_TIMESTAMP NOT NULL,
    CONSTRAINT "PK_daemon_pid_stats_id" PRIMARY KEY ("id")
);

CREATE TABLE "DB_stats" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "timestamp" varchar(60) NOT NULL,
    "graph_min" varchar(255) NOT NULL,
    "graph_max" varchar(255) NOT NULL,
    "graph_avg" varchar(255) NOT NULL,
    "graph_num" varchar(255) NOT NULL,
    "graph_total" varchar(255) NOT NULL,
    "kmz_min" varchar(255) NOT NULL,
    "kmz_max" varchar(255) NOT NULL,
    "kmz_avg" varchar(255) NOT NULL,
    "kmz_num" varchar(255) NOT NULL,
    "kmz_total" varchar(255) NOT NULL,
    "file_min" varchar(255) NOT NULL,
    "file_max" varchar(255) NOT NULL,
    "file_avg" varchar(255) NOT NULL,
    "file_num" varchar(255) NOT NULL,
    "file_up_totals" varchar(255) NOT NULL,
    "gpx_size" varchar(255) NOT NULL,
    "gpx_num" varchar(255) NOT NULL,
    "gpx_min" varchar(255) NOT NULL,
    "gpx_max" varchar(255) NOT NULL,
    "gpx_avg" varchar(255) NOT NULL,
    "daemon_size" varchar(255) NOT NULL,
    "daemon_num" varchar(255) NOT NULL,
    "daemon_min" varchar(255) NOT NULL,
    "daemon_max" varchar(255) NOT NULL,
    "daemon_avg" varchar(255) NOT NULL,
    "total_aps" varchar(255) NOT NULL,
    "wep_aps" varchar(255) NOT NULL,
    "open_aps" varchar(255) NOT NULL,
    "secure_aps" varchar(255) NOT NULL,
    "nuap" varchar(255) NOT NULL,
    "num_priv_geo" varchar(255) NOT NULL,
    "num_pub_geo" varchar(255) NOT NULL,
    "user" bytea NOT NULL,
    "ap_gps_totals" bytea NOT NULL,
    "top_ssids" bytea NOT NULL,
    "geos" bytea NOT NULL,
    CONSTRAINT "DB_stats$timestamp" UNIQUE ("timestamp")
);

CREATE TABLE "files" (
    "id" bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "file_name" varchar(255),
    "file_orig" varchar(255),
    "file_user" varchar(255),
    "file_date" timestamp(0) DEFAULT CURRENT_TIMESTAMP,
    "node_name" varchar(255),
    "otherusers" varchar(255),
    "notes" text,
    "title" varchar(255),
    "converted" smallint DEFAULT 0,
    "prev_ext" varchar(4),
    "type" varchar(50),
    "size" varchar(14),
    "aps" integer DEFAULT 0,
    "gps" integer DEFAULT 0,
    "ValidGPS" integer DEFAULT 0,
    "hash" varchar(255),
    "completed" smallint DEFAULT 0,
    "NewAPPercent" integer,
    CONSTRAINT "PK_id" PRIMARY KEY ("id"),
    CONSTRAINT "UK_hash" UNIQUE ("hash")
);

CREATE TABLE "files_bad" (
    "id" bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "file_name" varchar(255),
    "file_orig" varchar(255),
    "file_user" varchar(255),
    "file_date" timestamp(0) DEFAULT CURRENT_TIMESTAMP,
    "otherusers" varchar(255),
    "notes" text,
    "title" varchar(255),
    "size" varchar(14),
    "hash" varchar(255),
    "converted" smallint NOT NULL,
    "thread_id" integer DEFAULT 0 NOT NULL,
    "node_name" varchar(255) DEFAULT '0' NOT NULL,
    "prev_ext" varchar(4),
    "type" varchar(50),
    "error_msg" text,
    CONSTRAINT "PK_files_bad_id" PRIMARY KEY ("id")
);

CREATE TABLE "files_importing" (
    "id" bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "tmp_id" integer DEFAULT 0,
    "file_name" varchar(255),
    "file_orig" varchar(255),
    "file_user" varchar(255),
    "file_date" timestamp(0) DEFAULT CURRENT_TIMESTAMP,
    "otherusers" varchar(255),
    "notes" text,
    "title" varchar(255),
    "size" varchar(14),
    "hash" varchar(255),
    "converted" smallint DEFAULT 0 NOT NULL,
    "prev_ext" varchar(4),
    "type" varchar(50),
    "importing" smallint DEFAULT 0 NOT NULL,
    "ap" varchar(255),
    "tot" varchar(128),
    CONSTRAINT "PK_files_importing_id" PRIMARY KEY ("id"),
    CONSTRAINT "files_importing$hash" UNIQUE ("hash")
);

CREATE TABLE "files_tmp" (
    "id" bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "file_name" varchar(255),
    "file_orig" varchar(255),
    "file_user" varchar(255),
    "file_date" timestamp(0) DEFAULT CURRENT_TIMESTAMP,
    "otherusers" varchar(255),
    "notes" text,
    "title" varchar(255),
    "size" varchar(14),
    "hash" varchar(255),
    "converted" smallint DEFAULT 0 NOT NULL,
    "prev_ext" varchar(4),
    "type" varchar(50),
    CONSTRAINT "PK_files_tmp_id" PRIMARY KEY ("id")
);

CREATE TABLE "geonames" (
    "id" bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "geonameid" bigint NOT NULL,
    "name" varchar(255),
    "asciiname" varchar(255),
    "alternatenames" varchar(255),
    "latitude" varchar(255),
    "longitude" varchar(255),
    "feature_class" varchar(255),
    "feature_code" varchar(255),
    "country_code" varchar(255),
    "cc2" varchar(255),
    "admin1_code" varchar(255),
    "admin2_code" varchar(255),
    "admin3_code" varchar(255),
    "admin4_code" varchar(255),
    "population" varchar(255),
    "elevation" varchar(255),
    "gtopo30" varchar(255),
    "timezone" varchar(255),
    "mod_date" varchar(255),
    CONSTRAINT "PK_geonames_geonameid" PRIMARY KEY ("id")
);

CREATE TABLE "geonames_admin1" (
    "id" bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "admin1" varchar(64) NOT NULL,
    "name" varchar(200),
    "asciiname" varchar(200),
    "geonameid" bigint,
    CONSTRAINT "PK_geonames_admin1_id" PRIMARY KEY ("id"),
    CONSTRAINT "geonames_admin1$admin1" UNIQUE ("admin1")
);

CREATE TABLE "geonames_admin2" (
    "id" bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "admin2" varchar(64) NOT NULL,
    "name" varchar(200),
    "asciiname" varchar(200),
    "geonameid" bigint,
    CONSTRAINT "PK_geonames_admin2_id" PRIMARY KEY ("id"),
    CONSTRAINT "geonames_admin2$admin2" UNIQUE ("admin2")
);

CREATE TABLE "geonames_country_names" (
    "id" bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "ISO" varchar(255),
    "ISO3" varchar(255),
    "ISO-Numeric" varchar(255),
    "fips" varchar(255),
    "Country" varchar(255),
    "Capital" varchar(255),
    "Area" varchar(255),
    "Population" varchar(255),
    "Continent" varchar(255),
    "tld" varchar(255),
    "CurrencyCode" varchar(255),
    "CurrencyName" varchar(255),
    "Phone" varchar(255),
    "Postal Code Format" varchar(255),
    "Postal Code Regex" varchar(255),
    "Languages" varchar(255),
    "geonamesid" bigint,
    "neighbors" varchar(255),
    "EquivalentFipsCode" varchar(255)
);

CREATE TABLE "link_tokens" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "token" varchar(64) NOT NULL,
    "user_id" integer NOT NULL,
    "expires" timestamp(0) NOT NULL,
    "used" smallint DEFAULT 0 NOT NULL,
    "created_at" timestamp(0) NOT NULL,
    CONSTRAINT "PK_link_tokens_id" PRIMARY KEY ("id")
);

CREATE TABLE "live_aps" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "ssid" varchar(32) NOT NULL,
    "mac" varchar(64) NOT NULL,
    "auth" varchar(64) NOT NULL,
    "encry" varchar(64) NOT NULL,
    "sectype" integer NOT NULL,
    "radio" varchar(50) NOT NULL,
    "chan" integer NOT NULL,
    "sig" text NOT NULL,
    "username" varchar(255) NOT NULL,
    "session_id" varchar(255) NOT NULL,
    "ap_hash" varchar(255) NOT NULL,
    "BTx" varchar(255) NOT NULL,
    "OTx" varchar(255) NOT NULL,
    "NT" varchar(255) NOT NULL,
    "Label" varchar(255) NOT NULL,
    "FA" timestamp(0),
    "LA" timestamp(0),
    "lat" varchar(255) DEFAULT 'N 0.0000' NOT NULL,
    "long" varchar(255) DEFAULT 'E 0.0000' NOT NULL,
    CONSTRAINT "PK_live_aps_ap_hash" PRIMARY KEY ("ap_hash")
);

CREATE TABLE "live_gps" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "lat" varchar(255) NOT NULL,
    "long" varchar(255) NOT NULL,
    "sats" integer NOT NULL,
    "hdp" varchar(255) NOT NULL,
    "alt" varchar(255) NOT NULL,
    "geo" varchar(255) NOT NULL,
    "kmh" varchar(255) NOT NULL,
    "mph" varchar(255) NOT NULL,
    "track" varchar(255) NOT NULL,
    "session_id" varchar(255) NOT NULL,
    "hist_date" timestamp(0) DEFAULT CURRENT_TIMESTAMP NOT NULL,
    CONSTRAINT "PK_live_gps_id" PRIMARY KEY ("id")
);

CREATE TABLE "live_signals" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "ap_hash" varchar(255) NOT NULL,
    "signal" integer NOT NULL,
    "rssi" varchar(255) DEFAULT '0' NOT NULL,
    "gps_id" integer NOT NULL,
    "time_stamp" timestamp(0)
);

CREATE TABLE "live_titles" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "username" varchar(255) NOT NULL,
    "title" varchar(255) NOT NULL,
    "notes" varchar(255) NOT NULL,
    "session_id" varchar(255) NOT NULL
);

CREATE TABLE "live_users" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "username" varchar(255) NOT NULL,
    "session_id" varchar(255) NOT NULL,
    "title_id" integer,
    CONSTRAINT "PK_live_users_id" PRIMARY KEY ("id", "session_id")
);

CREATE TABLE "log" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "message" text NOT NULL,
    "level" varchar(255) NOT NULL,
    "timestamp" varchar(32) NOT NULL,
    "prefix" varchar(255) NOT NULL,
    CONSTRAINT "PK_log_id" PRIMARY KEY ("id")
);

CREATE TABLE "manufacturers" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "BSSID" varchar(6) NOT NULL,
    "Manufacturer" text NOT NULL,
    "modified" timestamp(0) NOT NULL,
    CONSTRAINT "PK_manufacturers_id" PRIMARY KEY ("id"),
    CONSTRAINT "manufacturers$BSSID" UNIQUE ("BSSID")
);

CREATE TABLE "pm" (
    "id" bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "thread_id" varchar(32),
    "title" varchar(255),
    "message" text,
    "user1" bigint,
    "user2" bigint,
    "user1read" smallint DEFAULT 0,
    "user2read" smallint DEFAULT 0,
    "user1del" smallint DEFAULT 0,
    "user2del" smallint DEFAULT 0,
    "stimestamp" timestamp(3),
    CONSTRAINT "PK_pm" PRIMARY KEY ("id")
);

CREATE TABLE "schedule" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "nodename" varchar(255) NOT NULL,
    "daemon" varchar(255) NOT NULL,
    "enabled" smallint NOT NULL,
    "interval" integer NOT NULL,
    "status" varchar(255) NOT NULL,
    "nextrun" timestamp DEFAULT CURRENT_TIMESTAMP NOT NULL,
    "pid" integer,
    "pidfile" varchar(255),
    "logfile" varchar(255),
    CONSTRAINT "PK_schedule_id" PRIMARY KEY ("id")
);

CREATE TABLE "settings" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "daemon_state" integer NOT NULL,
    "version" varchar(255) NOT NULL,
    "apswithgps" integer DEFAULT 0 NOT NULL,
    "last_export_file" bigint DEFAULT 0 NOT NULL,
    "node_name" varchar(255) NOT NULL,
    CONSTRAINT "PK_settings_id" PRIMARY KEY ("id")
);

CREATE TABLE "share_waypoints" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "author" varchar(255) NOT NULL,
    "name" varchar(255) NOT NULL,
    "gcid" varchar(255) NOT NULL,
    "notes" text NOT NULL,
    "cat" varchar(255) NOT NULL,
    "type" varchar(255) NOT NULL,
    "diff" numeric(3, 2) NOT NULL,
    "terain" numeric(3, 2) NOT NULL,
    "lat" varchar(255) NOT NULL,
    "long" varchar(255) NOT NULL,
    "link" varchar(255) NOT NULL,
    "c_date" timestamp(0) NOT NULL,
    "u_date" timestamp(0) NOT NULL,
    "pvt_id" integer NOT NULL,
    "shared_by" varchar(255) NOT NULL,
    CONSTRAINT "share_waypoints$id" UNIQUE ("id")
);

CREATE TABLE "stats_cache" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "cache_key" varchar(100) NOT NULL,
    "cache_data" text NOT NULL,
    "updated_at" timestamp(3) DEFAULT CURRENT_TIMESTAMP NOT NULL,
    CONSTRAINT "PK_stats_cache" PRIMARY KEY ("id"),
    CONSTRAINT "UQ_stats_cache_key" UNIQUE ("cache_key")
);

CREATE TABLE "user_info" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY (START WITH 672) NOT NULL,
    "username" varchar(255) NOT NULL,
    "password" varchar(255) NOT NULL,
    "help" varchar(255),
    "uid" varchar(255) NOT NULL,
    "disabled" smallint DEFAULT 0 NOT NULL,
    "validated" smallint DEFAULT 0 NOT NULL,
    "locked" smallint DEFAULT 0 NOT NULL,
    "login_fails" integer DEFAULT 0 NOT NULL,
    "permissions" varchar(4) DEFAULT '0001' NOT NULL,
    "last_login" timestamp(0),
    "email" varchar(255) NOT NULL,
    "admin" smallint DEFAULT 0,
    "schedule" smallint DEFAULT 0 NOT NULL,
    "imports" smallint DEFAULT 0 NOT NULL,
    "kmz" smallint DEFAULT 0 NOT NULL,
    "new_users" smallint DEFAULT 0 NOT NULL,
    "h_email" smallint DEFAULT 0 NOT NULL,
    "join_date" timestamp(0),
    "friends" text,
    "foes" text,
    "website" varchar(255),
    "Vis_ver" varchar(255),
    "apikey" varchar(255),
    "import_require_login" integer DEFAULT 1 NOT NULL,
    CONSTRAINT "user_info$username" UNIQUE ("username")
);

CREATE TABLE "user_login_hashes" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "username" varchar(255) NOT NULL,
    "hash" varchar(255) NOT NULL,
    "utime" integer NOT NULL
);

CREATE TABLE "user_stats" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "newest" varchar(255) NOT NULL,
    "largest" varchar(255) NOT NULL,
    CONSTRAINT "user_stats$id" UNIQUE ("id")
);

CREATE TABLE "user_validate" (
    "id" bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "username" varchar(255) NOT NULL,
    "code" varchar(64) NOT NULL,
    "date" timestamp DEFAULT CURRENT_TIMESTAMP NOT NULL,
    CONSTRAINT "user_validate$username" UNIQUE ("username")
);

CREATE TABLE "user_waypoints" (
    "id" integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "author" varchar(255) NOT NULL,
    "name" varchar(255) NOT NULL,
    "shared_by" varchar(255) NOT NULL,
    "gcid" varchar(255) NOT NULL,
    "notes" text NOT NULL,
    "cat" varchar(255) NOT NULL,
    "type" varchar(255) NOT NULL,
    "diff" numeric(3, 2) NOT NULL,
    "terain" numeric(3, 2) NOT NULL,
    "lat" varchar(255) NOT NULL,
    "long" varchar(255) NOT NULL,
    "link" varchar(255) NOT NULL,
    "share" smallint NOT NULL,
    "share_id" integer NOT NULL,
    "c_date" timestamp(0) NOT NULL,
    "u_date" timestamp(0) NOT NULL,
    CONSTRAINT "user_waypoints$id" UNIQUE ("id")
);

CREATE TABLE "wifi_ap" (
    "AP_ID" bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "BSSID" varchar(50),
    "SSID" varchar(255),
    "CHAN" integer,
    "AUTH" varchar(50),
    "ENCR" varchar(50),
    "SECTYPE" integer,
    "RADTYPE" varchar(50),
    "NETTYPE" varchar(100),
    "BTX" varchar(100),
    "OTX" varchar(100),
    "FLAGS" varchar(255),
    "HighGps_ID" bigint,
    "File_ID" bigint,
    "high_sig" integer,
    "high_rssi" integer,
    "high_gps_sig" integer,
    "high_gps_rssi" integer,
    "ap_hash" varchar(255),
    "points" bigint,
    "fa" timestamp(3),
    "la" timestamp(3),
    "ModDate" timestamp(3) DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT "PK_wifi_ap" PRIMARY KEY ("AP_ID")
);

CREATE TABLE "wifi_gps" (
    "GPS_ID" bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "File_ID" bigint,
    "File_GPS_ID" bigint,
    "Lat" numeric(9, 4),
    "Lon" numeric(9, 4),
    "NumOfSats" integer,
    "HorDilPitch" numeric(10, 2),
    "Alt" numeric(7, 2),
    "Geo" numeric(10, 2),
    "MPH" numeric(10, 2),
    "KPH" numeric(10, 2),
    "TrackAngle" numeric(5, 2),
    "AccuracyMeters" numeric(10, 2),
    "GPS_Date" timestamp(3),
    CONSTRAINT "PK_wifi_gps_GPS_ID" PRIMARY KEY ("GPS_ID")
);

CREATE TABLE "wifi_hist" (
    "Hist_ID" bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    "AP_ID" bigint,
    "GPS_ID" bigint,
    "File_ID" bigint,
    "Sig" integer,
    "RSSI" integer,
    "New" smallint,
    "Hist_Date" timestamp(3),
    CONSTRAINT "PK_wifi_hist_Hist_ID" PRIMARY KEY ("Hist_ID")
);

--
-- Indexes
--

CREATE INDEX "idx_admin_jobs_created" ON "admin_jobs" ("created_at");
CREATE INDEX "idx_admin_jobs_status" ON "admin_jobs" ("status");
CREATE INDEX "annunc_id" ON "annunc" ("id");
CREATE INDEX "boundaries_id" ON "boundaries" ("id");
CREATE INDEX "IX_cell_hist_cell_id" ON "cell_hist" ("cell_id");
CREATE INDEX "IX_cell_hist_file_id" ON "cell_hist" ("file_id");
CREATE INDEX "IX_cell_hist_gps_id" ON "cell_hist" ("gps_id");
CREATE INDEX "IX_cell_hist_hist_date" ON "cell_hist" ("hist_date");
CREATE INDEX "IX_cell_id_cell_hash" ON "cell_id" ("cell_hash");
CREATE INDEX "IX_cell_id_fa" ON "cell_id" ("fa");
CREATE INDEX "IX_cell_id_file_id" ON "cell_id" ("file_id");
CREATE INDEX "IX_cell_id_highgps_id" ON "cell_id" ("highgps_id");
CREATE INDEX "IX_cell_id_mac" ON "cell_id" ("mac");
CREATE INDEX "IX_cell_id_points" ON "cell_id" ("points");
CREATE INDEX "IX_cell_id_type" ON "cell_id" ("type");
CREATE INDEX "IX_cell_id_type_fa" ON "cell_id" ("type", "fa");
CREATE INDEX "DB_stats_id" ON "DB_stats" ("id");
CREATE INDEX "IX_aps" ON "files" ("aps");
CREATE INDEX "IX_completed" ON "files" ("completed");
CREATE INDEX "IX_file_orig" ON "files" ("file_orig");
CREATE INDEX "IX_gps" ON "files" ("gps");
CREATE INDEX "IX_ValidGPS" ON "files" ("ValidGPS");
CREATE INDEX "admin1_code" ON "geonames" ("admin1_code");
CREATE INDEX "admin2_code" ON "geonames" ("admin2_code");
CREATE INDEX "admin3_code" ON "geonames" ("admin3_code");
CREATE INDEX "admin4_code" ON "geonames" ("admin4_code");
CREATE INDEX "alternatenames" ON "geonames" ("alternatenames");
CREATE INDEX "asciiname" ON "geonames" ("asciiname");
CREATE INDEX "country_code" ON "geonames" ("country_code");
CREATE INDEX "elevation" ON "geonames" ("elevation");
CREATE INDEX "feature_class" ON "geonames" ("feature_class");
CREATE INDEX "feature_code" ON "geonames" ("feature_code");
CREATE INDEX "geonames_id" ON "geonames" ("id");
CREATE INDEX "latitude" ON "geonames" ("latitude");
CREATE INDEX "longitude" ON "geonames" ("longitude");
CREATE INDEX "name" ON "geonames" ("name");
CREATE INDEX "population" ON "geonames" ("population");
CREATE INDEX "timezone" ON "geonames" ("timezone");
CREATE INDEX "geonamesid" ON "geonames_country_names" ("geonamesid");
CREATE INDEX "geonames_country_names_id" ON "geonames_country_names" ("id");
CREATE INDEX "live_aps_id" ON "live_aps" ("id");
CREATE INDEX "live_gps_id" ON "live_gps" ("id");
CREATE INDEX "ap_hash" ON "live_signals" ("ap_hash", "signal", "gps_id", "time_stamp");
CREATE INDEX "FK_ap_hash_gps" ON "live_signals" ("gps_id");
CREATE INDEX "live_signals_id" ON "live_signals" ("id");
CREATE INDEX "live_titles_id" ON "live_titles" ("id");
CREATE INDEX "user_info_id" ON "user_info" ("id");
CREATE INDEX "user_login_hashes_id" ON "user_login_hashes" ("id");
CREATE INDEX "user_validate_id" ON "user_validate" ("id");
CREATE INDEX "wifi_ap_IX_File_ID" ON "wifi_ap" ("File_ID");
CREATE INDEX "IX_MSREC1" ON "wifi_ap" ("CHAN", "SECTYPE") INCLUDE ("BSSID", "SSID", "AUTH", "ENCR", "BTX", "OTX", "FLAGS", "HighGps_ID", "high_rssi", "high_gps_sig", "high_gps_rssi", "ap_hash", "RADTYPE", "NETTYPE", "points", "fa", "la", "ModDate", "File_ID", "high_sig");
CREATE INDEX "wifi_ap_IX_MSREC3" ON "wifi_ap" ("HighGps_ID") INCLUDE ("BSSID");
CREATE INDEX "IX_MSREC4" ON "wifi_ap" ("fa") INCLUDE ("SECTYPE");
CREATE INDEX "IX_wifi_ap_ap_hash" ON "wifi_ap" ("ap_hash");
CREATE INDEX "IX_wifi_ap_bssid" ON "wifi_ap" ("BSSID");
CREATE INDEX "IX_wifi_ap_chan" ON "wifi_ap" ("CHAN");
CREATE INDEX "IX_wifi_ap_fa" ON "wifi_ap" ("fa");
CREATE INDEX "IX_wifi_ap_HighGps_covering" ON "wifi_ap" ("HighGps_ID") INCLUDE ("AP_ID", "BSSID", "SSID", "CHAN", "AUTH", "ENCR", "SECTYPE", "RADTYPE", "NETTYPE", "BTX", "OTX", "fa", "la", "points", "high_gps_sig", "high_gps_rssi", "File_ID") WHERE "points" IS NOT NULL;
CREATE INDEX "IX_wifi_ap_HighGps_ID" ON "wifi_ap" ("HighGps_ID");
CREATE INDEX "IX_wifi_ap_la" ON "wifi_ap" ("la" DESC);
CREATE INDEX "IX_wifi_ap_la_tile" ON "wifi_ap" ("la") INCLUDE ("AP_ID", "HighGps_ID", "File_ID", "BSSID", "SSID", "CHAN", "AUTH", "ENCR", "SECTYPE", "RADTYPE", "NETTYPE", "BTX", "OTX", "fa", "points", "high_gps_sig", "high_gps_rssi") WHERE "HighGps_ID" IS NOT NULL AND "points" IS NOT NULL;
CREATE INDEX "IX_wifi_ap_mod_date" ON "wifi_ap" ("ModDate" DESC);
CREATE INDEX "IX_wifi_ap_points" ON "wifi_ap" ("points" DESC);
CREATE INDEX "IX_wifi_ap_radtype" ON "wifi_ap" ("RADTYPE");
CREATE INDEX "IX_wifi_ap_sectype" ON "wifi_ap" ("SECTYPE");
CREATE INDEX "IX_wifi_ap_ssid" ON "wifi_ap" ("SSID");
CREATE INDEX "File_GPS_ID" ON "wifi_gps" ("File_GPS_ID");
CREATE INDEX "wifi_gps_File_ID" ON "wifi_gps" ("File_ID");
CREATE INDEX "IX_Lat" ON "wifi_gps" ("Lat") INCLUDE ("Lon", "Alt");
CREATE INDEX "IX_MSREC2" ON "wifi_gps" ("File_ID", "File_GPS_ID") INCLUDE ("Lat", "Lon", "GPS_Date");
CREATE INDEX "IX_wifi_gps_LatLon" ON "wifi_gps" ("Lat", "Lon") INCLUDE ("GPS_ID", "Alt");
CREATE INDEX "AP_ID" ON "wifi_hist" ("AP_ID");
CREATE INDEX "wifi_hist_File_ID" ON "wifi_hist" ("File_ID");
CREATE INDEX "GPS_ID" ON "wifi_hist" ("GPS_ID");
CREATE INDEX "Hist_Date" ON "wifi_hist" ("Hist_Date");
CREATE INDEX "IX_AP_ID_NEW_HDATE" ON "wifi_hist" ("AP_ID") INCLUDE ("File_ID", "New", "Hist_Date");
CREATE INDEX "wifi_hist_IX_File_ID" ON "wifi_hist" ("File_ID") INCLUDE ("AP_ID", "GPS_ID");
CREATE INDEX "IX_FileID_GPSID_Sig_RSSI_New_Date" ON "wifi_hist" ("AP_ID", "File_ID") INCLUDE ("GPS_ID", "Sig", "RSSI", "New", "Hist_Date");
CREATE INDEX "IX_MSREC_APID_NEW_HIST_DATE" ON "wifi_hist" ("File_ID") INCLUDE ("AP_ID", "New", "Hist_Date");
CREATE INDEX "wifi_hist_IX_MSREC3" ON "wifi_hist" ("AP_ID", "Hist_Date") INCLUDE ("GPS_ID", "Sig", "RSSI");
CREATE INDEX "New" ON "wifi_hist" ("New");
CREATE INDEX "RSSI" ON "wifi_hist" ("RSSI");
CREATE INDEX "Sig" ON "wifi_hist" ("Sig");

--
-- Foreign keys
--

ALTER TABLE "live_signals" ADD CONSTRAINT "live_signals$FK_ap_hash_gps" FOREIGN KEY ("gps_id") REFERENCES "live_gps" ("id");
ALTER TABLE "wifi_hist" ADD CONSTRAINT "wifi_hist$wifi_hist_ibfk_2" FOREIGN KEY ("GPS_ID") REFERENCES "wifi_gps" ("GPS_ID");

